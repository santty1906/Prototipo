# =============================================================================
# Talent Profile System — environment template
# =============================================================================
# Copy to `.env.local` and fill in from your own Supabase project:
#   Supabase Dashboard → Project Settings → API
#
# `.env.local` is git-ignored. Never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# Public — inlined into the browser bundle. Safe to expose.
# -----------------------------------------------------------------------------
# e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable key.
# New projects: `sb_publishable_...`   Older projects: the legacy `anon` JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# -----------------------------------------------------------------------------
# Server-only — NEVER prefix this with NEXT_PUBLIC_.
# It bypasses every RLS policy. Treat it like a root password.
# New projects: `sb_secret_...`        Older projects: the legacy `service_role` JWT.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# -----------------------------------------------------------------------------
# AI Talent Consultant — server-only. NEVER prefix this with NEXT_PUBLIC_.
# The browser calls /api/ai/consult; only the server calls Anthropic.
# Get a key at https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
